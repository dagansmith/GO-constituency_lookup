# Copy to .env in the repository root (never under public/) and chmod 600.
# src/bootstrap.php reads this file as data for both web requests and CLI
# scripts; variables already in the process environment take precedence.
# Format (also safe to source from /bin/sh): one KEY=value per line, optional
# "export ", '#' comments. Use 'single quotes' for values with spaces or shell
# characters. Unquoted values and "double quotes" must not contain $ or
# backticks: such lines are ignored (their line numbers, never values, are logged).
AN_API_TOKEN=
AN_CONSTITUENCY_FIELD=parliamentary_constituency
# Leave empty to read postal_addresses[].postal_code (primary address first).
AN_POSTCODE_FIELD=
AN_API_BASE_URL=https://actionnetwork.org/api/v2
PARLIAMENT_LOOKUP_URL=https://members-api.parliament.uk/api/Location/Constituency/Search
PARLIAMENT_MEMBERS_LOOKUP_URL=https://members-api.parliament.uk/api/Members/Search
# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
WEBHOOK_SECRET=
# Leave unset to use the repository's var/locks directory.
# Set an absolute path shared by webhook and cron, outside the web root.
# LOCK_DIRECTORY=/var/lib/constituency-lookup/locks
# Durable webhook queue. Leave unset to use the repository's var/queue directory.
# Set an absolute path writable by BOTH the web PHP user and the cron user,
# outside the web root.
# QUEUE_DIRECTORY=/var/lib/constituency-lookup/queue
HTTP_RETRIES=2
HTTP_TIMEOUT_SECONDS=15
